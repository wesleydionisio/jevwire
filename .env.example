# Pick a provider. `auto` (the default) uses TypeSafe when TYPESAFE_API_KEY is set,
# else OpenRouter when OPENROUTER_API_KEY is set. Naming one never falls back to the other.
# JEV_PROVIDER=auto        # auto | typesafe | openrouter

# TypeSafe (https://typesafe.ai)
TYPESAFE_API_KEY=sk-...

# OpenRouter (https://openrouter.ai) -- use instead of TypeSafe:
#   JEV_PROVIDER=openrouter
#   OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_API_KEY=sk-or-...

# Optional overrides (defaults shown)
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# OPENROUTER_BASE_URL=https://openrouter.ai/api/alpha
# JEV_MODEL=jev-latest     # OpenRouter: typesafe/jev-1.13 (jev-latest maps to it)
# JEV_TIMEOUT_MS=30000
# JEV_MAX_RETRIES=3
# JEV_AUTO_THRESHOLD=0.85
# JEV_REVIEW_THRESHOLD=0.6
# JEV_MAX_CONCURRENCY=4
